# Copie este arquivo para .env (que NÃO vai para o Git) e cole as suas chaves.
# Abra no Bloco de Notas e cole ali; nunca cole chaves em chat.
# Todas são gratuitas. Chave vazia = a fonte é pulada e o relatório sai com as outras.

# Google Gemini (IA): https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-sua-chave-aqui
# VirusTotal (4 consultas/min, 500/dia): https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=cole-sua-chave-aqui
# abuse.ch, para URLhaus e ThreatFox: https://auth.abuse.ch/
ABUSECH_AUTH_KEY=cole-sua-chave-aqui
# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=cole-sua-chave-aqui
# AbuseIPDB (1.000 consultas/dia): https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=cole-sua-chave-aqui
